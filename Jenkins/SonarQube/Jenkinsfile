pipeline {
    agent {
        dockerfile {
            filename 'Dockerfile.agent'
            dir 'Jenkins/SonarQube'
            reuseNode true
        }
    }
    
    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }
    triggers {
        pollSCM('H * * * *')
    }
    parameters {
        string(name: 'MARKDOWN_FILE', defaultValue: 'origen.md', description: 'Nombre del archivo markdown en la carpeta SonarQube')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Instalacion de dependencias') {
            steps {
                dir('Jenkins/SonarQube') {
                    sh 'npm install --no-save @marp-team/marp-cli sonar-scanner'
                }
            }
        }

        stage('Generacion del PDF') {
            steps {
                dir('Jenkins/SonarQube') {
                    sh '''
                        mkdir -p pdf
                        MD_FILE="$MARKDOWN_FILE"
                        if [ ! -f "$MD_FILE" ]; then
                            MD_FILE="$(basename "$MARKDOWN_FILE")"
                        fi
                        if [ ! -f "$MD_FILE" ]; then
                            echo "No existe el archivo markdown: $MARKDOWN_FILE"
                            exit 1
                        fi
                        BASENAME="$(basename "$MD_FILE" .md)"
                        npx marp "$MD_FILE" --pdf --output "pdf/${BASENAME}.pdf"
                    '''
                }
            }
        }

        stage('Analisis SonarQube') {
            steps {
                dir('Jenkins/SonarQube') {
                    withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONARQUBE_TOKEN')]) {
                        sh '''
                            npx sonar-scanner \
                                -Dsonar.projectKey=KAI_SQ \
                                -Dsonar.sources=. \
                                -Dsonar.projectName=KAI_SQ \
                                -Dsonar.projectVersion=${BUILD_NUMBER} \
                                -Dsonar.host.url=http://host.docker.internal:9000 \
                                -Dsonar.login=${SONARQUBE_TOKEN} \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions=**/pdf/**,**/node_modules/**
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    dir('Jenkins/SonarQube') {
                        withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONARQUBE_TOKEN')]) {
                            sh '''
                                end=$((SECONDS+300))
                                status="PENDING"
                                while [ $SECONDS -lt $end ]; do
                                    response="$(curl -s -u "$SONARQUBE_TOKEN:" "http://host.docker.internal:9000/api/qualitygates/project_status?projectKey=KAI_SQ")"
                                    status="$(echo "$response" | tr ',' '\n' | grep '"status"' | head -n 1 | cut -d'"' -f4)"
                                    if [ "$status" = "OK" ] || [ "$status" = "ERROR" ] || [ "$status" = "WARN" ]; then
                                        break
                                    fi
                                    sleep 5
                                done

                                echo "Quality Gate status: $status"
                                if [ "$status" != "OK" ]; then
                                    echo "Quality Gate no superado"
                                    exit 1
                                fi
                            '''
                        }
                    }
                }
            }
        }

        stage('Archivado del artefacto') {
            steps {
                archiveArtifacts artifacts: 'Jenkins/SonarQube/pdf/*.pdf', fingerprint: true, onlyIfSuccessful: true
            }
        }
    }
}