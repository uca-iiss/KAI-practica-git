pipeline {
    agent {
        dockerfile {
            filename 'Dockerfile'
            dir 'Jenkins/Ej3'
        }
    }
    
    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }
    triggers {
        pollSCM('H * * * *')
    }
    parameters {
        string(name: 'MARKDOWN_FILE', defaultValue: 'Jenkins/Ej3/origen.md', description: 'Nombre del archivo markdown en la carpeta Ej3')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Instalacion de dependencias') {
            steps {
                sh 'npm install --no-save @marp-team/marp-cli'
            }
        }

        stage('Generacion del PDF') {
            steps {
                sh '''
                    mkdir -p pdf
                    if [ ! -f "$MARKDOWN_FILE" ]; then
                        echo "No existe el archivo markdown: $MARKDOWN_FILE"
                        exit 1
                    fi
                    BASENAME="$(basename "$MARKDOWN_FILE" .md)"
                    npx marp "$MARKDOWN_FILE" --pdf --output "pdf/${BASENAME}.pdf"
                '''
            }
        }

        stage('Archivado del artefacto') {
            steps {
                archiveArtifacts artifacts: 'pdf/*.pdf', fingerprint: true, onlyIfSuccessful: true
            }
        }
    }
}
