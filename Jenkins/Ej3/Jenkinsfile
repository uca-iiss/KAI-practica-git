pipeline {
    agent {
        dockerfile {
            filename 'Dockerfile'
            dir 'Jenkins/Ej3'
        }
    }
    
    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }
    triggers {
        pollSCM('H * * * *')
    }
    parameters {
        string(name: 'MARKDOWN_FILE', defaultValue: 'origen.md', description: 'Nombre del archivo markdown a procesar')
        string(name: 'GIT_CREDENTIALS_ID', defaultValue: 'GitToken for Jekins Ej3', description: 'ID de credencial Jenkins para push a GitHub')
        string(name: 'TARGET_BRANCH', defaultValue: 'entrega-jenkins', description: 'Rama destino para subir el PDF')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Instalacion de dependencias') {
            steps {
                dir('Jenkins/Ej3') {
                    sh 'npm install --no-save @marp-team/marp-cli'
                }
            }
        }

        stage('Generacion del PDF') {
            steps {
                sh '''
                    mkdir -p Jenkins/Ej3/pdf

                    if [ -f "$MARKDOWN_FILE" ]; then
                        MARKDOWN_PATH="$MARKDOWN_FILE"
                    elif [ -f "Jenkins/Ej3/$MARKDOWN_FILE" ]; then
                        MARKDOWN_PATH="Jenkins/Ej3/$MARKDOWN_FILE"
                    else
                        echo "No existe el archivo markdown: $MARKDOWN_FILE"
                        exit 1
                    fi

                    BASENAME="$(basename "$MARKDOWN_PATH" .md)"
                    Jenkins/Ej3/node_modules/.bin/marp "$MARKDOWN_PATH" --pdf --output "Jenkins/Ej3/pdf/${BASENAME}.pdf"
                '''
            }
        }

        stage('Archivado del artefacto') {
            steps {
                archiveArtifacts artifacts: 'Jenkins/Ej3/pdf/*.pdf', fingerprint: true, onlyIfSuccessful: true
            }
        }

        stage('Subida del PDF a GitHub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: params.GIT_CREDENTIALS_ID, usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                        sh '''
                            set -e
                            git config user.name "jenkins-bot"
                            git config user.email "jenkins-bot@local"

                            git add Jenkins/Ej3/pdf/*.pdf

                            if git diff --cached --quiet; then
                                echo "No hay cambios en PDF para subir"
                                exit 0
                            fi

                            ORIGIN_URL="$(git config --get remote.origin.url)"
                            if echo "$ORIGIN_URL" | grep -q '^https://'; then
                                CLEAN_URL="${ORIGIN_URL#https://}"
                                git remote set-url origin "https://${GIT_USER}:${GIT_TOKEN}@${CLEAN_URL}"
                            else
                                echo "La URL remota no es HTTPS. Configura remote.origin.url en HTTPS para usar token."
                                exit 1
                            fi

                            git commit -m "chore(ci): update generated marp pdf"
                            git push origin "HEAD:${TARGET_BRANCH}"
                        '''
                    }
                }
            }
        }
    }
}
