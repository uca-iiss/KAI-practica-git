pipeline {
    agent {
        dockerfile {
            filename 'Dockerfile'
            dir 'Jenkins/Ej3'
        }
    }
    
    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }
    triggers {
        pollSCM('H * * * *')
    }
    parameters {
        string(name: 'MARKDOWN_FILE', defaultValue: 'origen.md', description: 'Nombre del archivo markdown en la carpeta Ej3')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Instalacion de dependencias') {
            steps {
                dir('Jenkins/Ej3') {
                    sh 'npm install --no-save @marp-team/marp-cli'
                }
            }
        }

        stage('Generacion del PDF') {
            steps {
                dir('Jenkins/Ej3') {
                    sh '''
                        mkdir -p pdf
                        MD_FILE="$MARKDOWN_FILE"
                        if [ ! -f "$MD_FILE" ]; then
                            MD_FILE="$(basename "$MARKDOWN_FILE")"
                        fi
                        if [ ! -f "$MD_FILE" ]; then
                            echo "No existe el archivo markdown: $MARKDOWN_FILE"
                            exit 1
                        fi
                        BASENAME="$(basename "$MD_FILE" .md)"
                        npx marp "$MD_FILE" --pdf --output "pdf/${BASENAME}.pdf"
                    '''
                }
            }
        }

        stage('Archivado del artefacto') {
            steps {
                archiveArtifacts artifacts: 'Jenkins/Ej3/pdf/*.pdf', fingerprint: true, onlyIfSuccessful: true
            }
        }
    }
}